rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Publicly readable assets (Supports any nesting level)
    match /{path}/{allPaths=**} {
      allow read: if path in [
          'banners', 'teachers', 'satsang_banners', 'online_meeting_banners', 
          'book_covers', 'digital_books', 'audio_books', 'daily_zoom_meetings', 
          'test', 'branding', 'gallery'
      ];
      allow write: if request.auth != null;
    }
    
    // Private/Sensitive assets (Donation Receipts)
    match /transactions/{uid}/{filename} {
      allow read, write: if request.auth != null;
    }

    // Default: Deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
