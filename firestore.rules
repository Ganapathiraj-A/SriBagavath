rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    // Admins collection: Restrict read to the specific admin. Only admins can grant roles.
    match /admins/{adminId} {
      allow read: if request.auth != null && (
        request.auth.uid == adminId || 
        (request.auth.token.email != null && request.auth.token.email == adminId)
      );
      allow write: if isAdmin();
    }
    
    // Admin Requests: Users apply here. Admins review.
    match /admin_requests/{requestId} {
      allow read: if isAdmin() || (request.auth != null && requestId == request.auth.uid);
      allow create: if request.auth != null && 
        requestId == request.auth.uid &&
        request.resource.data.keys().hasAll(['email', 'name', 'timestamp']);
      allow update: if request.auth != null && requestId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Transactions: Reading restricted to Admin or Owner. Anyone authenticated can create for themselves.
    match /transactions/{txId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.status == 'PENDING'; // Force PENDING on creation
      allow update, delete: if isAdmin();
    }
    
    // Transaction Images: Restricted to Admin or Owner
    match /transaction_images/{txId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Catalog data: Publicly readable, writeable only by admins
    match /programs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /schedules/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /programTypes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /online_meetings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /satsangs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sathsangs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Explicitly allow public read for metadata
    match /system/metadata {
      allow read: if true;
    }

    // Settings partitioning:
    // Public: Sync registry, min versions, display toggles
    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Admin/Private: Passwords, internal script URLs, sheet links
    match /settings/admin {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Legacy/Migration path (Locking it down)
    match /settings/global {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /daily_zoom_meetings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /daily_zoom_teachers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /daily_zoom_links/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /consultants/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /books/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /book_covers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /digital_book_configs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /debug_devices/{deviceId} {
      // Public read to allow diagnostic tools to check authorization
      allow read: if true;
      // Only Admins can authorize a device (enforces self-device authorization by logic in the app)
      allow write: if isAdmin();
    }

    match /program_banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audio_books/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /relatedVideos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /diagnostic_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.auth != null || 
        get(/databases/$(database)/documents/debug_devices/$(request.resource.data.deviceId)).data.isAuthorized == true;
      allow update, delete: if isAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Global fallback: Deny everything else
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
